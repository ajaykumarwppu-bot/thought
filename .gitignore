```gitignore
# Compiled and binary files
*.pyc
__pycache__/
*.class
*.o
*.exe
*.dll
*.so
*.a
*.obj
*.out

# Dependencies
node_modules/
venv/
.venv/
.env
.env.local
*.env.*

# Build artifacts
dist/
build/
target/

# Editors and IDEs
.vscode/
.idea/
*.swp
*.swo

# System files
.DS_Store
Thumbs.db

# Logs and temp files
*.log
*.tmp

# Coverage
coverage/
htmlcov/
.coverage

# Python specific
.mypy_cache/
.pytest_cache/
*.pyc
__pycache__/
```